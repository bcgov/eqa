<script setup>
import { Head, Link, router } from '@inertiajs/vue3'
import { ref, computed } from 'vue'

const props = defineProps({
    institutions: {
        type: Array,
        default: () => [],
    },
    filters: {
        type: Object,
        default: () => ({}),
    },
})

const search = ref(props.filters?.search ?? '')

const filteredInstitutions = computed(() => {
    if (!search.value) {
        return props.institutions
    }
    const term = search.value.toLowerCase()
    return props.institutions.filter((institution) =>
        Object.values(institution).some((value) =>
            String(value ?? '').toLowerCase().includes(term)
        )
    )
})

function onSearch() {
    router.get(
        route('web.designated-institutions.index'),
        { search: search.value },
        { preserveState: true, replace: true }
    )
}
</script>

<template>
    <Head title="Designated Institutions" />

    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <h1 class="text-2xl font-semibold text-gray-900">Designated Institutions</h1>

            <div class="w-full sm:w-72">
                <input
                    v-model="search"
                    type="text"
                    placeholder="Search institutions..."
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                    @input="onSearch"
                />
            </div>
        </div>

        <div class="mt-6 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th
                            scope="col"
                            class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                        >
                            Name
                        </th>
                        <th
                            scope="col"
                            class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                        >
                            Code
                        </th>
                        <th
                            scope="col"
                            class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                        >
                            Status
                        </th>
                        <th