<script setup>
import { Head, Link, useForm, router } from '@inertiajs/vue3'
import { ref, computed } from 'vue'

const props = defineProps({
    institutions: {
        type: Object,
        default: () => ({ data: [] }),
    },
    filters: {
        type: Object,
        default: () => ({}),
    },
})

const search = ref(props.filters?.search ?? '')

const form = useForm({
    name: '',
    code: '',
    address: '',
    city: '',
    state: '',
    postal_code: '',
    country: '',
    is_active: true,
})

const showModal = ref(false)
const editingId = ref(null)

const modalTitle = computed(() => (editingId.value ? 'Edit Institution' : 'New Institution'))

function openCreate() {
    editingId.value = null
    form.reset()
    form.clearErrors()
    showModal.value = true
}

function openEdit(institution) {
    editingId.value = institution.id
    form.clearErrors()
    form.name = institution.name
    form.code = institution.code
    form.address = institution.address
    form.city = institution.city
    form.state = institution.state
    form.postal_code = institution.postal_code
    form.country = institution.country
    form.is_active = institution.is_active
    showModal.value = true
}

function closeModal() {
    showModal.value = false
    form.reset()
    form.clearErrors()
}

function submit() {
    if (editingId.value) {
        form.put(route('web.institutions.update', editingId.value), {
            preserveScroll: true,
            onSuccess: () => closeModal(),
        })
    } else {
        form.post(route('web.institutions.store'), {
            preserveScroll: true,
            onSuccess: () => closeModal(),
        })
    }
}

function destroy(institution) {
    if (!confirm(`Delete institution "${institution.name}"?`)) {
        return
    }

    router.delete(route('web.institutions.destroy', institution.id), {
        preserveScroll: true,
    })
}

function runSearch() {
    router.get(
        route('web.institutions.index'),
        { search: search.value },
        { preserveState: true, replace: true }
    )
}
</script>

<template>
    <Head title="Institutions" />

    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <h1 class="text-2xl font-semibold text-gray-900">Institutions</h1>
            <button
                type="button"
                class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                @click="openCreate"
            >
                New Institution
            </button>
        </div>

        <div class="mt-6 flex items-center gap-2">
            <input
                v-model="search"
                type="text"
                placeholder="Search institutions..."
                class="w-full max-w-sm rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
                @keyup.enter="runSearch"
            />
            <button
                type="button"
                class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"
                @click="runSearch"
            >
                Search
            </button>
        </div>

        <div class="mt-6 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Code</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-