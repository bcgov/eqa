<script setup>
import { Head, Link, router, useForm } from '@inertiajs/vue3'
import { ref, computed } from 'vue'

const props = defineProps({
    campuses: {
        type: Array,
        default: () => [],
    },
    filters: {
        type: Object,
        default: () => ({}),
    },
})

const search = ref(props.filters?.search ?? '')
const showModal = ref(false)
const editingCampus = ref(null)

const form = useForm({
    name: '',
    code: '',
    address: '',
    city: '',
    state: '',
    zip: '',
    phone: '',
    is_active: true,
})

const filteredCampuses = computed(() => {
    if (!search.value) {
        return props.campuses
    }
    const term = search.value.toLowerCase()
    return props.campuses.filter((campus) =>
        [campus.name, campus.code, campus.city]
            .filter(Boolean)
            .some((value) => value.toLowerCase().includes(term))
    )
})

function openCreateModal() {
    editingCampus.value = null
    form.reset()
    form.clearErrors()
    showModal.value = true
}

function openEditModal(campus) {
    editingCampus.value = campus
    form.clearErrors()
    form.name = campus.name
    form.code = campus.code
    form.address = campus.address
    form.city = campus.city
    form.state = campus.state
    form.zip = campus.zip
    form.phone = campus.phone
    form.is_active = campus.is_active
    showModal.value = true
}

function closeModal() {
    showModal.value = false
    editingCampus.value = null
    form.reset()
    form.clearErrors()
}

function submit() {
    if (editingCampus.value) {
        form.put(route('web.campuses.update', editingCampus.value.id), {
            preserveScroll: true,
            onSuccess: () => closeModal(),
        })
    } else {
        form.post(route('web.campuses.store'), {
            preserveScroll: true,
            onSuccess: () => closeModal(),
        })
    }
}

function destroy(campus) {
    if (confirm(`Delete campus "${campus.name}"?`)) {
        router.delete(route('web.campuses.destroy', campus.id), {
            preserveScroll: true,
        })
    }
}

function runSearch() {
    router.get(
        route('web.campuses.index'),
        { search: search.value },
        { preserveState: true, replace: true }
    )
}
</script>

<template>
    <Head title="Campuses" />

    <div class="mx-auto max-w-6xl px-4 py-8">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-2xl font-semibold text-gray-900">Campuses</h1>
            <button
                type="button"
                class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500"
                @click="openCreateModal"
            >
                New Campus
            </button>
        </div>

        <div class="mb-4 flex gap-2">
            <input
                v-model="search"
                type="text"
                placeholder="Search campuses..."
                class="w-full max-w-sm rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                @keyup.enter="runSearch"
            />
            <button
                type="button"
                class="rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
                @click="runSearch"
            >
                Search
            </button>
        </div>

        <div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Code</th>
                        <th class="px-4 py-3 text-left text-xs font-medium u